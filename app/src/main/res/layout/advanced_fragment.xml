<?xml version="1.0" encoding="utf-8"?>
<!-- Advanced settings. Ids are the ones AdvancedFragment binds. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <TextView style="@style/SettingsSection" android:tag="section" android:layout_marginTop="4dp"
        android:text="@string/settings_section_log" />

    <LinearLayout style="@style/SettingsGroup" android:tag="group">
        <LinearLayout style="@style/SettingsFieldRow">
            <TextView style="@style/SettingsFieldLabel" android:tag="label" android:labelFor="@id/loglevel" android:text="@string/advanced_settings_logLevel" />
            <Spinner android:id="@+id/loglevel" style="@style/SettingsFieldValue" />
        </LinearLayout>
        <View style="@style/SettingsDivider" android:tag="divider" />
        <CheckBox android:id="@+id/logProtocol" style="@style/SettingsSwitch" android:text="@string/advanced_settings_logProtocol" />
        <View style="@style/SettingsDivider" android:tag="divider" />
        <CheckBox android:id="@+id/enable_debug" style="@style/SettingsSwitch" android:text="@string/advanced_settings_enabledebug" />
        <View style="@style/SettingsDivider" android:tag="divider" />
        <LinearLayout style="@style/SettingsFieldRow">
            <TextView style="@style/SettingsFieldLabel" android:tag="label" android:labelFor="@id/log_dir" android:text="@string/advanced_settings_logDir" />
            <EditText android:id="@+id/log_dir" style="@style/SettingsFieldValue" android:imeOptions="actionDone" android:inputType="text" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <TextView style="@style/SettingsSection" android:tag="section" android:text="@string/settings_section_wireless" />

    <LinearLayout style="@style/SettingsGroup" android:tag="group">
        <CheckBox android:id="@+id/enable_wifi" style="@style/SettingsSwitch" android:text="@string/advanced_settings_enablewifi" />
        <TextView style="@style/SettingsHint" android:tag="hint" android:paddingTop="0dp" android:paddingBottom="14dp"
            android:text="@string/advanced_settings_enablewifi_hint" />
    </LinearLayout>

    <TextView style="@style/SettingsSection" android:tag="section" android:text="@string/settings_section_honda" />

    <LinearLayout style="@style/SettingsGroup" android:tag="group">
        <CheckBox android:id="@+id/enable_hondaintegration" style="@style/SettingsSwitch" android:text="@string/advanced_settings_enablehondaintegration" />
        <View style="@style/SettingsDivider" android:tag="divider" />
        <CheckBox android:id="@+id/enable_hondamicvr" style="@style/SettingsSwitch" android:text="@string/advanced_settings_enablehondamicvr" />
        <View style="@style/SettingsDivider" android:tag="divider" />
        <CheckBox android:id="@+id/enable_usebtmicvr" style="@style/SettingsSwitch" android:text="@string/advanced_settings_usebtmicvr" />
        <View style="@style/SettingsDivider" android:tag="divider" />
        <CheckBox android:id="@+id/enable_hondaimid" style="@style/SettingsSwitch" android:text="@string/advanced_settings_enablehondaimid" />
        <View style="@style/SettingsDivider" android:tag="divider" />
        <CheckBox android:id="@+id/honda_keep_source" style="@style/SettingsSwitch" android:text="@string/advanced_settings_honda_keep_source" />
        <View style="@style/SettingsDivider" android:tag="divider" />
        <CheckBox android:id="@+id/honda_return_to_projection" style="@style/SettingsSwitch" android:text="@string/advanced_settings_honda_return_to_projection" />
        <View style="@style/SettingsDivider" android:tag="divider" />
        <CheckBox android:id="@+id/honda_block_bt_voice" style="@style/SettingsSwitch" android:text="@string/advanced_settings_honda_block_bt_voice" />
        <View style="@style/SettingsDivider" android:tag="divider" />
        <LinearLayout style="@style/SettingsFieldRow">
            <TextView style="@style/SettingsFieldLabel" android:tag="label" android:labelFor="@id/modemgraudiovideo_idx" android:text="@string/advanced_settings_modeMgrAudioVideoIdx" />
            <EditText android:id="@+id/modemgraudiovideo_idx" style="@style/SettingsFieldValue" android:imeOptions="actionDone" android:inputType="number" android:maxLines="1" />
        </LinearLayout>
        <View style="@style/SettingsDivider" android:tag="divider" />
        <LinearLayout style="@style/SettingsFieldRow">
            <TextView style="@style/SettingsFieldLabel" android:tag="label" android:labelFor="@id/modemgrvideo_idx" android:text="@string/advanced_settings_modeMgrVideoIdx" />
            <EditText android:id="@+id/modemgrvideo_idx" style="@style/SettingsFieldValue" android:imeOptions="actionDone" android:inputType="number" android:maxLines="1" />
        </LinearLayout>
        <View style="@style/SettingsDivider" android:tag="divider" />
        <LinearLayout style="@style/SettingsFieldRow">
            <TextView style="@style/SettingsFieldLabel" android:tag="label" android:labelFor="@id/sw_mode" android:text="@string/advanced_settings_swmode" />
            <Spinner android:id="@+id/sw_mode" style="@style/SettingsFieldValue" />
        </LinearLayout>
        <View style="@style/SettingsDivider" android:tag="divider" />
        <LinearLayout style="@style/SettingsFieldRow">
            <TextView style="@style/SettingsFieldLabel" android:tag="label" android:labelFor="@id/steeringwheel_idx" android:text="@string/advanced_settings_steeringWheelIdx" />
            <EditText android:id="@+id/steeringwheel_idx" style="@style/SettingsFieldValue" android:enabled="false" android:imeOptions="actionDone" android:inputType="number" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
