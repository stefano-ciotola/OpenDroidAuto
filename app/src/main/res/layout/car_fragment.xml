<?xml version="1.0" encoding="utf-8"?>
<!-- Car settings. tag="section|group|divider|label|hint" drive the styling in
     BaseSettingsFragment; ids are the ones CarFragment binds. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <TextView style="@style/SettingsSection" android:tag="section" android:layout_marginTop="4dp"
        android:text="@string/settings_section_general" />

    <LinearLayout style="@style/SettingsGroup" android:tag="group">
        <LinearLayout style="@style/SettingsFieldRow">
            <TextView style="@style/SettingsFieldLabel" android:tag="label"
                android:labelFor="@id/app_language" android:text="@string/app_language" />
            <Spinner android:id="@+id/app_language" style="@style/SettingsFieldValue" />
        </LinearLayout>
        <View style="@style/SettingsDivider" android:tag="divider" />
        <LinearLayout style="@style/SettingsFieldRow">
            <TextView style="@style/SettingsFieldLabel" android:tag="label" android:text="@string/theme_title" />
            <LinearLayout
                android:id="@+id/theme_segment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="3dp">
                <Button android:id="@+id/theme_dark" style="@style/SettingsSegment" android:text="@string/theme_option_dark" />
                <Button android:id="@+id/theme_light" style="@style/SettingsSegment" android:text="@string/theme_option_light" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView style="@style/SettingsSection" android:tag="section" android:text="@string/settings_section_clock" />

    <LinearLayout style="@style/SettingsGroup" android:tag="group">
        <CheckBox android:id="@+id/hide_clock" style="@style/SettingsSwitch" android:text="@string/car_settings_hide_clock" />
        <View style="@style/SettingsDivider" android:tag="divider" />
        <CheckBox android:id="@+id/hide_hu_clock" style="@style/SettingsSwitch" android:text="@string/car_settings_hide_hu_clock" />
    </LinearLayout>

    <TextView style="@style/SettingsSection" android:tag="section" android:text="@string/settings_section_android_auto" />

    <LinearLayout style="@style/SettingsGroup" android:tag="group">
        <CheckBox android:id="@+id/play_media_during_vr" style="@style/SettingsSwitch" android:text="@string/car_settings_play_media_during_vr" />
        <View style="@style/SettingsDivider" android:tag="divider" />
        <CheckBox android:id="@+id/left_drive" style="@style/SettingsSwitch" android:text="@string/car_settings_left_drive" />
    </LinearLayout>

    <TextView style="@style/SettingsSection" android:tag="section" android:text="@string/settings_section_vehicle" />

    <LinearLayout style="@style/SettingsGroup" android:tag="group">
        <LinearLayout style="@style/SettingsFieldRow">
            <TextView style="@style/SettingsFieldLabel" android:tag="label" android:labelFor="@id/hu_name" android:text="@string/car_settings_hu_name" />
            <EditText android:id="@+id/hu_name" style="@style/SettingsFieldValue" android:imeOptions="actionDone" android:inputType="text" android:maxLines="1" />
        </LinearLayout>
        <View style="@style/SettingsDivider" android:tag="divider" />
        <LinearLayout style="@style/SettingsFieldRow">
            <TextView style="@style/SettingsFieldLabel" android:tag="label" android:labelFor="@id/car_model" android:text="@string/car_settings_model" />
            <EditText android:id="@+id/car_model" style="@style/SettingsFieldValue" android:imeOptions="actionDone" android:inputType="text" android:maxLines="1" />
        </LinearLayout>
        <View style="@style/SettingsDivider" android:tag="divider" />
        <LinearLayout style="@style/SettingsFieldRow">
            <TextView style="@style/SettingsFieldLabel" android:tag="label" android:labelFor="@id/car_year" android:text="@string/car_settings_year" />
            <EditText android:id="@+id/car_year" style="@style/SettingsFieldValue" android:imeOptions="actionDone" android:inputType="number" android:maxLines="1" />
        </LinearLayout>
        <View style="@style/SettingsDivider" android:tag="divider" />
        <LinearLayout style="@style/SettingsFieldRow">
            <TextView style="@style/SettingsFieldLabel" android:tag="label" android:labelFor="@id/hu_make" android:text="@string/car_settings_hu_make" />
            <EditText android:id="@+id/hu_make" style="@style/SettingsFieldValue" android:imeOptions="actionDone" android:inputType="text" android:maxLines="1" />
        </LinearLayout>
        <View style="@style/SettingsDivider" android:tag="divider" />
        <LinearLayout style="@style/SettingsFieldRow">
            <TextView style="@style/SettingsFieldLabel" android:tag="label" android:labelFor="@id/hu_model" android:text="@string/car_settings_hu_model" />
            <EditText android:id="@+id/hu_model" style="@style/SettingsFieldValue" android:imeOptions="actionDone" android:inputType="text" android:maxLines="1" />
        </LinearLayout>
        <View style="@style/SettingsDivider" android:tag="divider" />
        <LinearLayout style="@style/SettingsFieldRow">
            <TextView style="@style/SettingsFieldLabel" android:tag="label" android:labelFor="@id/sw_build" android:text="@string/car_settings_sw_build" />
            <EditText android:id="@+id/sw_build" style="@style/SettingsFieldValue" android:imeOptions="actionDone" android:inputType="text" android:maxLines="1" />
        </LinearLayout>
        <View style="@style/SettingsDivider" android:tag="divider" />
        <LinearLayout style="@style/SettingsFieldRow">
            <TextView style="@style/SettingsFieldLabel" android:tag="label" android:labelFor="@id/sw_version" android:text="@string/car_settings_sw_version" />
            <EditText android:id="@+id/sw_version" style="@style/SettingsFieldValue" android:imeOptions="actionDone" android:inputType="text" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
