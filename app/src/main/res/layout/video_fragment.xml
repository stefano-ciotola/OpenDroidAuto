<?xml version="1.0" encoding="utf-8"?>
<!-- Video settings, grouped like the design. Ids are the ones VideoFragment binds. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <TextView style="@style/SettingsSection" android:tag="section" android:layout_marginTop="4dp"
        android:text="@string/settings_section_projection" />

    <LinearLayout style="@style/SettingsGroup" android:tag="group">
        <LinearLayout style="@style/SettingsFieldRow">
            <TextView style="@style/SettingsFieldLabel" android:tag="label" android:labelFor="@id/video_resolution" android:text="@string/video_settings_resolution" />
            <Spinner android:id="@+id/video_resolution" style="@style/SettingsFieldValue" />
        </LinearLayout>
        <View style="@style/SettingsDivider" android:tag="divider" />
        <LinearLayout style="@style/SettingsFieldRow">
            <TextView style="@style/SettingsFieldLabel" android:tag="label" android:labelFor="@id/video_fps" android:text="@string/video_settings_fps" />
            <Spinner android:id="@+id/video_fps" style="@style/SettingsFieldValue" />
        </LinearLayout>
        <View style="@style/SettingsDivider" android:tag="divider" />
        <LinearLayout style="@style/SettingsFieldRow">
            <TextView style="@style/SettingsFieldLabel" android:tag="label" android:labelFor="@id/video_dpi" android:text="@string/video_settings_dpi" />
            <EditText android:id="@+id/video_dpi" style="@style/SettingsFieldValue" android:imeOptions="actionDone" android:inputType="number" android:maxLines="1" />
        </LinearLayout>
        <View style="@style/SettingsDivider" android:tag="divider" />
        <LinearLayout style="@style/SettingsFieldRow">
            <TextView style="@style/SettingsFieldLabel" android:tag="label" android:labelFor="@id/video_margin" android:text="@string/video_settings_margin" />
            <EditText android:id="@+id/video_margin" style="@style/SettingsFieldValue" android:imeOptions="actionDone" android:inputType="text" android:maxLines="1" />
        </LinearLayout>
        <View style="@style/SettingsDivider" android:tag="divider" />
        <LinearLayout style="@style/SettingsFieldRow">
            <TextView style="@style/SettingsFieldLabel" android:tag="label" android:labelFor="@id/video_night_mode" android:text="@string/video_settings_nightmode" />
            <Spinner android:id="@+id/video_night_mode" style="@style/SettingsFieldValue" />
        </LinearLayout>
    </LinearLayout>

    <TextView style="@style/SettingsSection" android:tag="section" android:text="@string/settings_section_background" />

    <LinearLayout style="@style/SettingsGroup" android:tag="group">
        <CheckBox android:id="@+id/showMediaNotification" style="@style/SettingsSwitch" android:text="@string/video_show_media_notification" />
        <View style="@style/SettingsDivider" android:tag="divider" />
        <CheckBox android:id="@+id/showNavigationNotification" style="@style/SettingsSwitch" android:text="@string/video_show_navigation_notification" />
        <View style="@style/SettingsDivider" android:tag="divider" />
        <CheckBox android:id="@+id/showAppBadge" style="@style/SettingsSwitch" android:text="@string/video_show_app_badge" />
    </LinearLayout>

    <TextView style="@style/SettingsSection" android:tag="section" android:text="@string/settings_section_diagnostics" />

    <LinearLayout style="@style/SettingsGroup" android:tag="group">
        <TextView style="@style/SettingsHint" android:tag="hint" android:text="@string/video_settings_experimental_hint" />
        <CheckBox android:id="@+id/videoStatsOverlay" style="@style/SettingsSwitch" android:text="@string/video_stats_overlay" />
        <View style="@style/SettingsDivider" android:tag="divider" />
        <CheckBox android:id="@+id/videoDecoderOneInput" style="@style/SettingsSwitch" android:text="@string/video_decoder_one_input" />
        <View style="@style/SettingsDivider" android:tag="divider" />
        <CheckBox android:id="@+id/videoDecoderSpsLowLatency" style="@style/SettingsSwitch" android:text="@string/video_decoder_sps_low_latency" />
        <View style="@style/SettingsDivider" android:tag="divider" />
        <CheckBox android:id="@+id/videoDecoderSpsLevel31" style="@style/SettingsSwitch" android:text="@string/video_decoder_sps_level_31" />
        <View style="@style/SettingsDivider" android:tag="divider" />
        <CheckBox android:id="@+id/videoDecoderEarlyRelease" style="@style/SettingsSwitch" android:text="@string/video_decoder_early_release" />
        <View style="@style/SettingsDivider" android:tag="divider" />
        <CheckBox android:id="@+id/videoDecoderIdlePush" style="@style/SettingsSwitch" android:text="@string/video_decoder_idle_push" />
        <View style="@style/SettingsDivider" android:tag="divider" />
        <CheckBox android:id="@+id/videoDecoderNvidiaLowBuffer" style="@style/SettingsSwitch" android:text="@string/video_decoder_nvidia_low_buffer" />
        <View style="@style/SettingsDivider" android:tag="divider" />
        <CheckBox android:id="@+id/videoDecoderNvidiaNoDpb" style="@style/SettingsSwitch" android:text="@string/video_decoder_nvidia_no_dpb" />
        <View style="@style/SettingsDivider" android:tag="divider" />
        <CheckBox android:id="@+id/videoDecoderNvidiaFullFrame" style="@style/SettingsSwitch" android:text="@string/video_decoder_nvidia_full_frame" />
        <View style="@style/SettingsDivider" android:tag="divider" />
        <CheckBox android:id="@+id/videoDecoderLegacyDrop" style="@style/SettingsSwitch" android:text="@string/video_decoder_legacy_drop" />
    </LinearLayout>
</LinearLayout>
