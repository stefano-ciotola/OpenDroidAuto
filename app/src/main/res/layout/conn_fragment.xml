<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <TextView style="@style/SettingsSection" android:tag="section" android:layout_marginTop="4dp"
        android:text="@string/settings_section_bluetooth" />

    <LinearLayout style="@style/SettingsGroup" android:tag="group">
        <CheckBox android:id="@+id/enable_ad2p" style="@style/SettingsSwitch" android:text="@string/conn_settings_enableAd2p" />
        <View style="@style/SettingsDivider" android:tag="divider" />
        <CheckBox android:id="@+id/enable_hfp" style="@style/SettingsSwitch" android:text="@string/conn_settings_enableHfp" />
    </LinearLayout>
</LinearLayout>
